# Upload / queue limits
MAX_UPLOAD_MB=500
MAX_VIDEO_DURATION_SECONDS=0
MAX_PENDING_JOBS=64

# Whisper runtime
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_FAST_MODEL=tiny
WHISPER_ACCURATE_MODEL=medium
WHISPER_CPU_THREADS=0
WHISPER_NUM_WORKERS=1
WHISPER_BATCH_SIZE=1
PRELOAD_FAST_MODEL=1
PRELOAD_ACCURATE_MODEL=0
TRANSCRIBE_WORKERS=2

# ffmpeg binaries/tuning
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_THREADS=0

# Cache / retention
JOB_TTL_SECONDS=7200
JOB_RETENTION_SECONDS=604800
TRANSCRIPT_CACHE_TTL_SECONDS=86400
TRANSCRIPT_CACHE_MAX_ITEMS=256
JOBS_DB_PATH=data/jobs.sqlite3

# SSE / maintenance
SSE_POLL_INTERVAL_SECONDS=0.8
SSE_MAX_SECONDS=3600
SSE_HEARTBEAT_SECONDS=12
MAINTENANCE_INTERVAL_SECONDS=300

# Logging
LOG_LEVEL=INFO
